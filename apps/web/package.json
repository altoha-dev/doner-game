{
  "name": "@doner-game/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.ts",
    "test:browser": "node test/browser/game.mjs",
    "test:party": "node test/browser/party.mjs",
    "test:interactions": "node test/browser/interactions.mjs"
  },
  "dependencies": {
    "@doner-game/shared": "workspace:*",
    "phaser": "4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.0",
    "vite": "^8.3.4"
  }
}
