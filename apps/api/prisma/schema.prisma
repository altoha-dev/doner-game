generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  telegramId         BigInt              @unique
  username           String?
  firstName          String
  lastName           String?
  photoUrl           String?
  languageCode       String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  lastLoginAt        DateTime            @default(now()) @db.Timestamptz(3)
  progress           PlayerProgress?
  unlockedCharacters UnlockedCharacter[]
}

model PlayerProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  doners              Int      @default(0)
  goldenDoners        Int      @default(0)
  campaignStage       Int      @default(0)
  selectedCharacterId String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UnlockedCharacter {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  characterId String
  unlockedAt  DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}
